<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.05.0.0">
<procedure name="main">
<interface/>
<body>
<c>* Main Procedure (Entry Point)</c>
<l>exit ()</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
<procedure name="detect_mold">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="ModelPath" base_type="ctrl" dimension="0"/>
<par name="MinScore" base_type="ctrl" dimension="0"/>
<par name="NumMatches" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ResultRow" base_type="ctrl" dimension="0"/>
<par name="ResultColumn" base_type="ctrl" dimension="0"/>
<par name="ResultAngle" base_type="ctrl" dimension="0"/>
<par name="ResultScore" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* Initialization</c>
<l>ResultRow := []</l>
<l>ResultColumn := []</l>
<l>ResultAngle := []</l>
<l>ResultScore := []</l>
<c></c>
<c>* Use Model File Path from Input Parameter</c>
<l>ModelFile := ModelPath</l>
<c></c>
<c>* Validate Input Parameters (Defaults)</c>
<l>if (MinScore &lt; 0.1 or MinScore &gt; 1.0)</l>
<l>    EffectiveMinScore := 0.5</l>
<l>else</l>
<l>    EffectiveMinScore := MinScore</l>
<l>endif</l>
<c></c>
<l>if (NumMatches &lt; 0)</l>
<l>    EffectiveNumMatches := 0</l>
<l>else</l>
<l>    EffectiveNumMatches := NumMatches</l>
<l>endif</l>
<c></c>
<c>* Check if model exists</c>
<l>file_exists (ModelFile, FileExists)</l>
<c></c>
<l>if (FileExists == 0)</l>
<c>    * --- TRAINING PHASE (Fallback if shm missing) ---</c>
<l>    tuple_regexp_replace (ModelPath, '\\\\[^\\\\]+\\.shm$', '\\\\roi_template.png', GoldenImagePath)</l>
<l>    file_exists (GoldenImagePath, ImgExists)</l>
<l>    if (ImgExists)</l>
<l>        read_image (TemplateImage, GoldenImagePath)</l>
<l>        create_scaled_shape_model (TemplateImage, 'auto', rad(0), rad(360), 'auto', 0.9, 1.1, 'auto', 'auto', 'ignore_global_polarity', 'auto', 'auto', ModelID)</l>
<l>        write_shape_model (ModelID, ModelFile)</l>
<l>    else</l>
<l>        return ()</l>
<l>    endif</l>
<l>else</l>
<l>    read_shape_model (ModelFile, ModelID)</l>
<l>endif</l>
<c></c>
<c>* --- MATCHING PHASE ---</c>
<l>count_obj (Image, NumObj)</l>
<l>if (NumObj == 0)</l>
<l>    return ()</l>
<l>endif</l>
<c></c>
<c>* Find Scaled Shape Model</c>
<c>* Use EffectiveMinScore for threshold and EffectiveNumMatches for limit</c>
<l>find_scaled_shape_model (Image, ModelID, rad(-45), rad(90), 0.9, 1.1, EffectiveMinScore, EffectiveNumMatches, 0.5, 'least_squares', 0, 0.1, ResultRow, ResultColumn, ResultAngle, ResultScale, ResultScore)</l>
<c></c>
<l>clear_shape_model (ModelID)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="detect_mold">
<parameters>
<parameter id="Image"/>
<parameter id="ModelPath"/>
<parameter id="MinScore"/>
<parameter id="NumMatches"/>
<parameter id="ResultAngle"/>
<parameter id="ResultColumn"/>
<parameter id="ResultRow"/>
<parameter id="ResultScore"/>
</parameters>
</docu>
</procedure>
</hdevelop>
